# Bu fayldan `.env` nusxa oling va qiymatlarni to'ldiring (`.env` ni git'ga QO'SHMANG).

# ============================================================================
# ASOSIY (majburiy)
# ============================================================================
# Asosiy domen (subdomensiz). Cloudflare tunnel shu domenga ulanadi.
ROOT_DOMAIN=wunderkindlc.uz

# FAQAT shu host ilovani (SPA) ochadi.
APP_HOST=app.wunderkindlc.uz

# PostgreSQL parol/foydalanuvchi/baza. Parolni kuchli qo'ying. User/DB ixtiyoriy (default: wunderkindlc).
POSTGRES_PASSWORD=ChangeMe_Str0ng_Pass
POSTGRES_USER=wunderkindlc
POSTGRES_DB=wunderkindlc

# Birinchi ishga tushishda (baza bo'sh) yaratiladigan super admin. Birinchi kirgach parolni o'zgartiring.
OWNER_LOGIN=admin
OWNER_PASSWORD=ChangeMe_Owner_Pass1

# JWT imzo kaliti — kamida 32 belgi tasodifiy satr.  Masalan:  openssl rand -base64 48
JWT_KEY=REPLACE_WITH_RANDOM_48_CHARS_MINIMUM_xxxxxxxxxxxxxx

# Cloudflare Tunnel tokeni — Zero Trust → Networks → Tunnels → (tunnel) → token.
TUNNEL_TOKEN=eyJ...your-tunnel-token...

# PostHog (frontend analitika). Kalit OMMAVIY (brauzer bundle'ida ko'rinadi) — maxfiy emas.
# Build-time (Vite) o'zgaruvchi, shuning uchun docker-compose "app" xizmatiga build ARG sifatida
# uzatiladi. Bo'sh qoldirilsa quyidagi default (loyiha) kaliti ishlatiladi.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=

# ============================================================================
# INTEGRATSIYALAR
# ----------------------------------------------------------------------------
# MUHIM — KALITLAR FAQAT SHU YERDA:
#   Barcha MAXFIY qiymatlar (bot tokeni, FCM service account, Gemini/Azure kaliti, Eskiz
#   login/paroli, turniket login/paroli) FAQAT .env dan o'qiladi. Ular BAZADA SAQLANMAYDI va
#   CRM Sozlamalar sahifasidan KIRITILMAYDI — sahifada faqat "sozlangan / sozlanmagan" holati
#   va shu yerga qo'shiladigan qator ko'rinadi. Sabab: baza dump'i, Telegram'ga yuboriladigan
#   zaxira nusxa yoki SQL kirishi orqali kalitlar sizib chiqmasin.
#   O'zgartirgandan keyin: `docker compose up -d` (konteyner yangi qiymat bilan qayta yaratiladi).
#
#   MAXFIY BO'LMAGAN sozlamalar (bot username/nomi, kanal, turniket IP/porti, yoqish-o'chirish
#   bayroqlari, soatlar) ENV-WINS bo'lib qoladi: .env'da berilsa har deploy'da qo'llanadi,
#   bo'sh qoldirilsa UI (Sozlamalar)dan boshqariladi.
# ============================================================================

# ---- Telegram bot (e'lon, ota-ona ro'yxati, yangi lid xabarnomasi, backup yuborish) ----
# TOKEN (MAXFIY — faqat shu yerda) BotFather'dan. Bo'sh bo'lsa bot ishlamaydi.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_BOT_NAME=
# Markaz kanali (havola yoki @username) — o'quvchi/o'qituvchi ilovasida "kanalga o'tish".
TELEGRAM_CHANNEL=
# Admin chat ID — backup faylini yuborish uchun (masalan 123456789 yoki -100123456789).
TELEGRAM_ADMIN_CHAT_ID=

# ---- Karyera boti (Wunderkind Career — ishga qabul, ALOHIDA bot) ----
# BotFather'da IKKINCHI bot ochiladi va uning tokeni shu yerga qo'yiladi (MAXFIY).
# Bo'sh bo'lsa faqat karyera boti ishlamaydi — CRM va asosiy bot odatdagidek yuradi.
CAREER_BOT_TOKEN=
# Mini App manzili (bot inline tugmasi shuni ochadi). Bo'sh qoldirilsa APP_HOST'dan
# avtomatik yasaladi: https://<APP_HOST>/vakansiya
CAREER_MINIAPP_URL=

# ---- LOKAL DEV (hot reload — ./dev.sh) uchun TEST botlari ----
# Dev'da yuqoridagi JONLI tokenlar ATAYIN ISHLATILMAYDI: Telegram har yangilanishni faqat BIR
# MARTA yetkazadi, ya'ni lokal bot xuddi shu token bilan `getUpdates` qilsa — serverdagi bot
# foydalanuvchilarga javob bermay qoladi. Botni lokal sinamoqchi bo'lsangiz BotFather'da
# ALOHIDA test botlari oching va tokenini shu yerga qo'ying (bo'sh qoldirilsa botlar o'chiq).
DEV_TELEGRAM_BOT_TOKEN=
DEV_CAREER_BOT_TOKEN=
# Dev Mini App manzili (bo'sh -> http://localhost:5173/vakansiya)
DEV_CAREER_MINIAPP_URL=

# ---- Push (Firebase / FCM) ----
# Service account JSON (MAXFIY — ichida private_key; TO'LIQ, bir qatorda). Bo'sh -> push yo'q.
# Web/PWA push uchun kerak bo'lgan web config va VAPID kaliti OMMAVIY — ular UI'dan kiritiladi.
# Maslahat: JSON'ni bir qatorga aylantiring (yangi qatorlarsiz) va bitta qatorda qo'ying.
FCM_SERVICE_ACCOUNT_JSON=

# ---- AI Tahlil (Google Gemini) ----
# API kaliti (MAXFIY; aistudio.google.com/app/apikey). Bo'sh bo'lsa AI tahlil ishlamaydi.
GEMINI_API_KEY=
# Model nomi (ixtiyoriy). Default: gemini-3.1-flash-lite
GEMINI_MODEL=gemini-3.1-flash-lite
# Kunlik markaz AI tahlili: yoqilgan (true/false) va soati (0-23, Toshkent, default 8).
AI_ANALYSIS_ENABLED=
AI_ANALYSIS_HOUR=

# ---- Instagram AI agenti (Marketing bo'limi) ----
# Instagram Professional akkauntga kelgan izoh/DM larga AI javob beradi va lid yaratadi.
# Meta App: developers.facebook.com -> Instagram -> "API setup with Instagram login".
# ⚠️ App Review KERAK EMAS (Standard Access yetadi — akkaunt bizniki), Facebook Page ham shart emas.
# APP_SECRET (MAXFIY) — webhook imzosi (HMAC-SHA256) va OAuth token almashuvi uchun.
#   ⚠️ Bo'sh bo'lsa webhook so'rovlari RAD ETILADI (fail-closed) — modul ishlamaydi.
# VERIFY_TOKEN — Meta webhook manzilini tasdiqlaganda ishlatiladi. Uni O'ZINGIZ o'ylab topasiz
#   (masalan "ic_ig_2026_a7f3") va AYNAN shu qiymatni Meta'dagi "Verify token" maydoniga yozasiz.
# App ID (maxfiy emas) va qolgan sozlamalar CRM -> Marketing -> Sozlamalar sahifasidan kiritiladi.
#
# ⚠️ INSTAGRAM_ACCESS_TOKEN / INSTAGRAM_PAGE_ID kabi qatorlar bu yerda KERAK EMAS va ular
#   O'QILMAYDI ham. Internetdagi namunalarda ular uchraydi, chunki u yerda gap bitta skript
#   haqida. Bu yerda esa akkaunt tokeni OAuth orqali olinadi va `IgAccount` jadvaliga tushadi:
#   u 60 kunlik va 45-kunda fon xizmati uni AVTOMATIK yangilaydi -- `.env` ni server o'zi
#   tahrirlay olmagani uchun token bu faylda yashay olmaydi (60 kunda modul jimgina to'xtardi).
#   Akkaunt id lari ham shu yerdan: bitta emas, UCHTASI saqlanadi (user_id, app-scoped id,
#   username) -- cheksiz halqa himoyasi shularga tayanadi.
#   Ulash: CRM -> Marketing -> Sozlamalar -> "Instagram akkauntni ulash" (OAuth yurmasa
#   o'sha kartadagi "Token bilan qo'lda ulash" -- instagram/SOZLASH.md 6b).
# To'liq qo'llanma: instagram/SOZLASH.md
INSTAGRAM_APP_SECRET=
INSTAGRAM_VERIFY_TOKEN=

# ---- REKLAMA LIDLARI (Meta Lead Ads / "Instant Form") ----
# Instagram/Facebook reklamasidagi forma to'ldirilganda lid CRM'ga avtomatik tushadi.
# ⚠️ Bu izoh/DM'dan BOSHQA yo'l: lid FACEBOOK PAGE obyektining `leadgen` webhook'i orqali keladi
#   va `leads_retrieval` ruxsati (App Review + Business Verification) talab qilinadi.
# ⚠️ Ikkala kalitni ham BO'SH qoldiring, agar reklama va Instagram BITTA Meta ilovasida bo'lsa —
#   u holda yuqoridagi INSTAGRAM_* qiymatlari ishlatiladi. Ayri ilova bo'lsagina to'ldiring.
# Page Access Token esa `.env` da EMAS — u CRM -> Marketing -> Sozlamalar sahifasidan kiritiladi
#   (ish vaqtida olinadi va bazada saqlanadi, `IgAccount.AccessToken` bilan bir xil sabab).
META_APP_SECRET=
META_VERIFY_TOKEN=

# ---- SMS (Eskiz.uz) ----
# Kabinet login/paroli MAXFIY (faqat shu yerda). ESKIZ_FROM — jo'natuvchi nomi (maxfiy emas):
# uni UI (Sozlamalar -> SMS) boshqaradi; bu yerdagi qiymat faqat bazada hech narsa yo'q bo'lsa
# ZAXIRA sifatida ishlatiladi va UI'dagi tanlovni HECH QACHON bosib ketmaydi. Test uchun "4546".
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_FROM=4546

# ---- Speaking (Azure Cognitive Services) ---- (kalit MAXFIY; region ham shu yerdan)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# ---- Turniket / FaceID (o'qituvchilar davomati) ----
# Yoqilgan (true/false), vendor (hikvision|zkteco), IP/host, port — UI'dan ham sozlanadi;
# LOGIN/PAROL esa MAXFIY va faqat shu yerda.
TURNSTILE_ENABLED=
TURNSTILE_VENDOR=hikvision
TURNSTILE_HOST=
TURNSTILE_PORT=80
TURNSTILE_USERNAME=
TURNSTILE_PASSWORD=

# ---- Call Center (MoiZvonki — bulutli telefoniya) ----
# Operator telefoniga MoiZvonki ilovasi o'rnatiladi (SIM bilan) — GSM gateway shart emas.
# DOMAIN — kabinetingiz subdomeni (masalan "wunderkind" -> wunderkind.moizvonki.ru).
# USERNAME/API_KEY — kabinet email + Sozlamalar -> Integratsiya bo'limidagi kalit.
# Qo'ng'iroq API_KEY egasining telefonidan chiqadi. Webhook obunasi avtomatik (APP_HOST orqali).
# WEBHOOK_SECRET — ixtiyoriy; bo'sh qoldirilsa API_KEY'dan avtomatik hosil qilinadi.
MOIZVONKI_ENABLED=false
MOIZVONKI_DOMAIN=
MOIZVONKI_USERNAME=
MOIZVONKI_API_KEY=
MOIZVONKI_WEBHOOK_SECRET=

# ---- YUZ BILAN KIRISH (o'quvchi mobil ilovasi) ----
# Yuz vektorlarini BAZADA shifrlash kaliti (AES-256-GCM). base64, AYNAN 32 bayt:
#     openssl rand -base64 32
# ⚠️ SOZLANMASA MODUL UMUMAN ISHLAMAYDI (selfi so'ralmaydi, kirish odatdagidek parol bilan).
#    Biometrik vektorni shifrsiz saqlash varianti ATAYIN yo'q — baza dump'i Telegram'ga
#    yuboriladi. Startupda log'da ogohlantirish chiqadi.
# ⚠️ KALITNI YO'QOTMANG/ALMASHTIRMANG: eski etalonlar ochilmay qoladi va har bir o'quvchi
#    keyingi kirishda profil rasmi orqali QAYTA ro'yxatdan o'tadi (ma'lumot yo'qolmaydi,
#    lekin hammaga bir marta selfi qayta so'raladi). Kalitni parol menejerida saqlang.
FACE_VECTOR_KEY=

# ---- Ilova haqiqiyligi (Google Play Integrity — Android) ----
# Yuz vektori TELEFONDA hisoblanadi, ya'ni o'zgartirilgan APK soxta vektor yubora oladi.
# Play Integrity shu bo'shliqni qisman yopadi: token Google'da ochiladi va ilova Play'dan
# ekani, paket nomi va qurilma butunligi tekshiriladi.
# Bo'sh qoldirilsa: tekshiruv "notConfigured" bo'ladi va (sozlama majburiy bo'lmasa) kirishga
# TO'SIQ BO'LMAYDI — natija faqat urinishlar jurnaliga yoziladi.
# PLAY_INTEGRITY_SA_JSON bo'sh bo'lsa FCM_SERVICE_ACCOUNT_JSON zaxira sifatida ishlatiladi —
# u YARAYDI, agar o'sha GCP loyihasida "Play Integrity API" YOQILGAN va Play Console'dagi
# ilova o'sha loyihaga BOG'LANGAN bo'lsa (aks holda Google 403 beradi → "unavailable").
PLAY_INTEGRITY_SA_JSON=
PLAY_INTEGRITY_PACKAGE=

# ---- Kamera (videokuzatuv) ----
CAMERA_ENABLED=
# 24/7 diskka YOZIB borish (jonli kuzatuvdan ALOHIDA — o'chiq bo'lsa ham kameralar ko'rinaveradi).
# Bo'sh -> bazadagi qiymat o'zgarmaydi (default: O'CHIQ). Odatda UI'dan boshqariladi:
# Sozlamalar -> Kamera integratsiya.
# ⚠️ Yoqishdan OLDIN disk hisobini qiling — 1080p kamera ~20-43 GB/KUN, 8 kamera x 7 kun ~1.2 TB.
# Batafsil: .claude/rules/cameras.md
CAMERA_RECORD_ENABLED=

# ---- NVR (videoregistrator) arxivi ----
# NVR allaqachon 24/7 o'z disklariga yozadi. Yoqilsa BIZ hech narsa yozmaymiz — orqaga
# qaytarish va klip AYNAN NVR'dan olinadi (disk ~0, markaz kanali faqat so'ralganda band).
# Manzil/portni odatda UI'dan kiritish qulay: Sozlamalar -> Kamera integratsiya.
# Login/parol esa FAQAT shu yerda (bazada saqlanmaydi) — turniketdagi bilan bir xil qoida.
NVR_ENABLED=
NVR_HOST=
NVR_RTSP_PORT=554
NVR_ISAPI_PORT=80
NVR_VENDOR=hikvision
NVR_USERNAME=
NVR_PASSWORD=

# ---- Avtomatik to'lov eslatmasi (qarzdorlarga Telegram+push) ----
PAYMENT_REMINDERS_ENABLED=

# ---- Telegram backup (kunlik .sql.gz/JSON) ----
# Yoqilgan (true/false) + vaqti. Toshkent = UTC+5. App-side backup soat:daqiqani Toshkent vaqtida o'qiydi.
BACKUP_TELEGRAM_ENABLED=
BACKUP_HOUR=21
BACKUP_MINUTE=00

# ---- Lokal + off-site backup (backup konteyner) ----
# Nechа kundan eski LOKAL nusxalar o'chiriladi (off-site retention bulut siyosati bilan).
BACKUP_RETENTION_DAYS=7
# SHIFRLASH (tavsiya): bo'sh bo'lmasa har nusxa gpg AES-256 bilan shifrlanadi (.gpg). Kuchli parol qo'ying.
# DIQQAT: shu parolni XAVFSIZ joyda (parol menejeri) saqlang — serverda EMAS. Yo'qolsa backup ochilmaydi!
BACKUP_ENCRYPT_PASSPHRASE=
# OFF-SITE (tavsiya — 3-2-1 qoidasi): rclone remote nomi (masalan "r2:wunderkindlc-backups").
# Bo'sh -> off-site yo'q. Sozlash: DEPLOY.md "Off-site backup" bo'limi (rclone.conf -> ./backup-config/).
RCLONE_REMOTE=

# ---- IMPORT REJIMI (boshqa tizimdan ma'lumot ko'chirish) ----
# 1 bo'lsa: oylik hisob (accrual), qarzdorlik/dars/tug'ilgan kun eslatmalari va SMS YUBORILMAYDI.
# Ko'chirish tugagach BO'SH qoldiring va konteynerni qayta ishga tushiring — aks holda oylik
# hisob umuman yozilmaydi. Batafsil: docs/EDUTIZIM-IMPORT.md
IMPORT_MODE=
