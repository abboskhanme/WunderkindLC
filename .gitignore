# Lokal docker override (faqat shu mashinada — serverga tushmaydi)
docker-compose.override.yml

# Audit/review hisobot fayllari (generatsiya qilingan — repoga kerak emas)
*AUDIT*.md
*AUDIT*.txt
*_AUDIT*.md
# ISTISNO: modul qoidalari (.claude/rules/) — bular hisobot emas, LOYIHA hujjati.
# Windows'da git registrga sezgir emas (core.ignorecase=true), shuning uchun `audit.md`
# yuqoridagi `*AUDIT*.md` naqshiga TUSHIB QOLADI va jimgina commit'ga kirmay qolardi.
!.claude/rules/*audit*.md

# Lokal ish hujjatlari — mashinada qoladi, git'ga tushmaydi
CLAUDE.md
WORKLOG.md
DEPLOY.md
WunderkindLC_TZ.md

# Claude Code lokal sozlamalari (mashinaga xos ruxsat qoidalari) — .claude/skills, .claude/agents git'da qoladi
.claude/settings.local.json

# Asterisk manba arxivi va lokal yozuvlar (asterisk-local) - git'da saqlanmaydi
asterisk-local/*.tar.gz
asterisk-local/recordings/

# Lokal PWA hujjatlari (gitga kirmaydi)
student_pwa.md
teacher_pwa.md

# Backup off-site sozlamasi (rclone.conf — bulut kalitlari, hech qachon commit qilinmaydi)
backup-config/

# Baza backuplari (haqiqiy foydalanuvchi maʼlumotlari) — commit qilinmasin
backups/
# Telegram bot yuboradigan JSON backup (haqiqiy o'quvchi/parol-hash ma'lumotlari)
wunderkindlc_backup_*.json
