# Backend API manzili.
# Integratsiyalangan rejimda nisbiy "/api" ishlatiladi — Vite proxy uni
# ASP.NET backendiga (WunderkindLC.Server) yo'naltiradi (vite.config.ts).
VITE_API_BASE_URL=/api

# Mock rejim: backend API tayyor bo'lganda "false" qiling.
VITE_USE_MOCK=true

# PostHog browser analytics configuration.
VITE_POSTHOG_KEY=phc_your_project_token
VITE_POSTHOG_HOST=https://us.i.posthog.com
