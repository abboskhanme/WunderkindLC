# Backend API manzili (Vite proxy uni ASP.NET backendiga yo'naltiradi — vite.config.ts).
VITE_API_BASE_URL=/api

# Mock rejim: backend tayyor, real API ishlatiladi.
VITE_USE_MOCK=false

# PostHog analitika — O'CHIQ.
# ⚠️ Bu yerda avval BOSHQA loyihaning jonli kaliti turgan edi (phc_rF4d...): u bilan
# yangi loyihaning barcha sahifa ko'rishlari va foydalanuvchi id'lari eski egasining
# PostHog hisobiga ketardi. Bo'sh qoldirilsa SDK umuman yuklanmaydi (lib/posthog.ts).
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=
